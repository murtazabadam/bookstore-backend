generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  ACTIVE
  DRAFT
  OUT_OF_STOCK
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  size      String?
  color     String?
  sku       String?  @unique
  price     Decimal? @db.Decimal(10, 2)
  stock     Int      @default(0)
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String?
  name          String
  phone         String?
  role          Role      @default(CUSTOMER)
  emailVerified Boolean   @default(false)
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  orders        Order[]
  addresses     Address[]
  createdAt     DateTime  @default(now())
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  label     String?
  fullName  String
  phone     String
  street    String
  area      String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model EmailOtp {
  email     String   @id
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Category {
  id       String    @id @default(uuid())
  name     String
  slug     String    @unique
  imageUrl String?
  isActive Boolean   @default(true)
  products Product[]
}

model StoreSettings {
  id                    String   @id @default("singleton")
  storeName             String   @default("Maktabah Islamiyah")
  tagline               String?
  storeEmail            String?
  phone                 String?
  address               String?
  logoUrl               String?
  onlinePaymentsEnabled Boolean  @default(true)
  codEnabled            Boolean  @default(false)
  shippingCharge        Decimal  @default(0) @db.Decimal(10, 2)
  freeShippingThreshold Decimal  @default(0) @db.Decimal(10, 2)
  deliveryEstimate      String?
  courierName           String?
  trackingUrlTemplate   String?
  senderName            String?
  replyToEmail          String?
  adminAlertEmail       String?
  lowStockThreshold     Int      @default(10)
  updatedAt             DateTime @updatedAt
}

model Order {
  id                String      @id @default(uuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  status            OrderStatus @default(PENDING)
  total             Decimal     @db.Decimal(10, 2)
  shippingCharge    Decimal     @default(0) @db.Decimal(10, 2)
  shippingAddress   String
  trackingNumber    String?
  razorpayPaymentId String?
  items             OrderItem[]
  createdAt         DateTime    @default(now())
}

model Product {
  id            String           @id @default(uuid())
  name          String
  slug          String           @unique
  description   String
  price         Decimal          @db.Decimal(10, 2)
  originalPrice Decimal?         @db.Decimal(10, 2)
  stock         Int              @default(0)
  imageUrls     String[]
  attributes    Json             @default("{}")
  categoryId    String
  subcategory   String?
  brand         String?
  sku           String?          @unique
  status        ProductStatus    @default(ACTIVE)
  featured      Boolean          @default(false)
  category      Category         @relation(fields: [categoryId], references: [id])
  variants      ProductVariant[]
  orderItems    OrderItem[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model OrderItem {
  id              String  @id @default(uuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id])
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  variantInfo     Json    @default("{}")
  quantity        Int
  priceAtPurchase Decimal @db.Decimal(10, 2)
}
